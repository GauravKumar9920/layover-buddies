# Dependencies — npm workspaces hoist to the root node_modules, but some
# packages still resolve a local copy, so cover both.
node_modules/
apps/*/node_modules/
packages/*/node_modules/

# Build output
dist/
apps/*/dist/

# Turborepo cache
.turbo/
apps/*/.turbo/
packages/*/.turbo/

.env
.env.local
.vercel
supabase/functions/.env
supabase/.temp/
.DS_Store
*.log

# Scratch / debug artifacts (e.g. .tmp-android-screen.png)
.tmp-*
*.tmp

.claude/worktrees/

# iOS build artifacts (regenerated by `pod install` / Xcode)
apps/mobile/ios/Pods/
apps/mobile/ios/build/
apps/mobile/ios/DerivedData/
apps/mobile/ios/**/xcuserdata/

# Claude / AI tooling caches
.claude-flow/
.swarm/
apps/mobile/.claude-flow/
apps/mobile/.claude/
.claude/skills/
.claude/agents/
.claude/commands/
.claude/helpers/

# Local-only configs
.mcp.json

# Expo managed workflow — ios/ and android/ build output is regenerated by
# `expo prebuild` and contains build-time-injected secrets (Google Maps API
# key etc.). A minimal native skeleton is committed; the whole-dir rules below
# keep the regenerated/secret-bearing output out of version control.
apps/mobile/ios/
apps/mobile/android/

# Per-developer Claude config — references gitignored helpers (settings.json
# calls .claude/helpers/*.cjs, which is not committed). Leaving it tracked
# means anyone enabling Claude hooks downstream gets broken hook commands.
.claude/settings.json
.claude/settings.local.json
.env*

# Agent tooling local state (Codex CLI, claude-flow remnants, Kimi Work memory)
.codex/
.ruflo/
.ruvector/
.agents/
.kimi/
ruvector.db

# Local env backups
*.pre-admin2.bak

# Scratch dirs and Supabase Studio saved snippets (per-user)
output/
tmp/
tmp_pdf_audit/
supabase/snippets/
