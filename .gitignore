node_modules/
mobile/node_modules/
admin/node_modules/
dist/
admin/dist/
.env
.env.local
supabase/functions/.env
supabase/.temp/
.DS_Store
*.log

# Scratch / debug artifacts (e.g. .tmp-android-screen.png)
.tmp-*
*.tmp

.claude/worktrees/

# iOS build artifacts (regenerated by `pod install` / Xcode)
mobile/ios/Pods/
mobile/ios/build/
mobile/ios/DerivedData/
mobile/ios/**/xcuserdata/

# Claude / AI tooling caches
.claude-flow/
.swarm/
mobile/.claude-flow/
mobile/.claude/
.claude/skills/
.claude/agents/
.claude/commands/
.claude/helpers/

# Local-only configs
.mcp.json

# Expo managed workflow — ios/ and android/ are regenerated by `expo prebuild`
# and contain build-time-injected secrets (Google Maps API key etc.). Keep
# them out of version control.
mobile/ios/
mobile/android/

# Per-developer Claude config — references gitignored helpers (settings.json
# calls .claude/helpers/*.cjs, which is not committed). Leaving it tracked
# means anyone enabling Claude hooks downstream gets broken hook commands.
.claude/settings.json
.claude/settings.local.json
