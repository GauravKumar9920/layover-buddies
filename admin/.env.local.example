# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit it.

# Supabase project URL (same as the mobile app)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase SERVICE ROLE key (NOT the anon key!). This key bypasses RLS.
# Keep it local-only — never deploy this admin app publicly with this key in it.
# Find it at: Supabase Dashboard → Project Settings → API → service_role (secret).
VITE_SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Gate-keeper password for the admin UI. Plain-text — this is a solo dev tool
# running locally, not production auth. Change it to something long and random.
VITE_ADMIN_PASSWORD=change-me-to-a-long-random-string
