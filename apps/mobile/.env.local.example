# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local (it is git-ignored).
#
# LOCAL DEV: use the values shown below.
# PRODUCTION: replace with your hosted project URL and sb_publishable_* key
#             from the Supabase Dashboard → Project Settings → API.

# ── Supabase (required) ─────────────────────────────────────────────────────
# 127.0.0.1 works on Expo Web and iOS/Android simulators on the same Mac.
# For physical-device native testing, replace with your Mac's LAN IP, e.g.
#   http://10.0.0.5:54321
# but only on the device build — keep 127.0.0.1 for Expo Web.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Run `npx supabase status` in the project root to print the actual local key.
# It looks like:  sb_publishable_XXXXXXXXXXXXXXXXXXXX_XXXXXXXXXXX
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxx

# ── Razorpay (required for payments — deferred for MVP) ─────────────────────
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...

# ── Google Maps (required for live tour map) ────────────────────────────────
# Get your key at: https://console.cloud.google.com/apis/credentials
# Enable these APIs in your project:
#   • Maps SDK for iOS
#   • Maps SDK for Android
# Free tier: $200/month credit (~28,000 map loads free). Billing account required.
# Android Gradle reads this value at build time; the committed manifest only
# contains a placeholder. After adding the key, rebuild the native app.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── FlightAware (Phase 2 only — leave blank for MVP) ────────────────────────
FLIGHTAWARE_API_KEY=
