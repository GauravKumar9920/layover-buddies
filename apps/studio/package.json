{
  "name": "@detour/studio",
  "private": true,
  "version": "0.1.0",
  "description": "Detour structured content workspace powered by Sanity Studio.",
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "sanity dev --host 127.0.0.1 --port 3333",
    "build": "node scripts/build.mjs",
    "type-check": "tsc --noEmit",
    "test": "node scripts/check-schema.mjs",
    "deploy": "sanity deploy",
    "postinstall": "node ../../scripts/patch-unreleased-security.mjs .",
    "test:security": "node ../../scripts/test-unreleased-security.mjs .",
    "security:dependencies": "node ../../scripts/audit-dependencies.mjs ."
  },
  "dependencies": {
    "@sanity/vision": "6.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "6.9.1",
    "styled-components": "^6.1.19",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "@module-federation/dts-plugin": {
      "undici": "7.29.1"
    },
    "@vercel/frameworks": {
      "js-yaml": "3.15.2",
      "smol-toml": "1.9.0"
    },
    "typeid-js": {
      "uuid": "11.1.1"
    },
    "undici@>=6 <7": "6.28.1",
    "undici@>=7 <8": "7.29.1",
    "brace-expansion@>=2 <3": "2.1.7",
    "brace-expansion@>=4 <6": "5.0.12",
    "dompurify": "3.4.16",
    "smol-toml": "1.9.0",
    "source-map-js": "1.2.2",
    "markdown-it": "14.3.2",
    "braces": "3.0.3",
    "sprintf-js": "1.1.3"
  }
}
