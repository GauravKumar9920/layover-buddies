{
  "name": "@detour/studio",
  "private": true,
  "version": "0.1.0",
  "description": "Detour structured content workspace powered by Sanity Studio.",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "sanity dev --host 127.0.0.1 --port 3333",
    "build": "node scripts/build.mjs",
    "type-check": "tsc --noEmit",
    "test": "node scripts/check-schema.mjs",
    "deploy": "sanity deploy"
  },
  "dependencies": {
    "@sanity/vision": "6.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "6.9.1",
    "styled-components": "^6.1.19",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1"
  },
  "overrides": {
    "@module-federation/dts-plugin": {
      "undici": "7.29.0"
    },
    "@vercel/frameworks": {
      "js-yaml": "3.15.1",
      "smol-toml": "1.7.1"
    },
    "typeid-js": {
      "uuid": "11.1.1"
    }
  }
}
