---
import MobileShell from '../components/mobile/MobileShell.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { readLegacyDocument } from '../lib/legacy';
import { getSitePages } from '../lib/site-pages';

const page = (await getSitePages()).find((entry) => entry.route === '/404');
if (!page) throw new Error('Missing 404 page manifest');
const legacy = await readLegacyDocument(page);
---

<BaseLayout page={page} retainedHead={legacy.retainedHead + '<link rel="stylesheet" href="/assets/mobile/mobile.css">'} theme={legacy.theme}>
  <div id="mw-page-content" tabindex="-1"><Fragment set:html={legacy.body} /></div>
  <MobileShell contentTarget="#mw-page-content" />
</BaseLayout>
