---
import MobileHome from '../components/mobile/MobileHome.astro';
import MobileShell from '../components/mobile/MobileShell.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredPage from '../components/StructuredPage.astro';
import PlaceGuide from '../components/PlaceGuide.astro';
import LayoverChecker from '../components/LayoverChecker.astro';
import AccountPage from '../components/AccountPage.astro';
import PlanningHub from '../components/PlanningHub.astro';
import SearchPage from '../components/SearchPage.astro';
import checker from '../data/layover-checker.json';
import places from '../data/place-guides.json';
import { readLegacyDocument } from '../lib/legacy';
import { getSitePages, type SitePage } from '../lib/site-pages';

export async function getStaticPaths() {
  return (await getSitePages())
    .filter((page) => page.route !== '/404')
    .map((page) => ({
      params: { slug: page.route === '/' ? undefined : page.route.slice(1) },
      props: { page },
    }));
}

interface Props { page: SitePage }
const { page } = Astro.props;
const isHome = page.route === '/';
const isPlanningHub = page.route === '/guides';
const isSearch = page.route === '/search';
const isPlacePage = page.route === '/guides/places' || places.some(p => page.route === `/guides/${p.slug}`);
// Tool pages are Astro components; their manifests point at a legacy file only to satisfy the parity check.
const toolPage = page.route === '/guides/can-i-leave-mumbai-airport' ? 'checker' : page.route === '/login' ? 'login' : page.route === '/account' ? 'account' : undefined;
const legacy = !isPlacePage && !toolPage && !isPlanningHub && !isSearch && page.contentSource === 'local' ? await readLegacyDocument(page) : undefined;
const structuredHead = toolPage
  ? '<link rel="stylesheet" href="/assets/field-note.css"><link rel="stylesheet" href="/assets/tools.css">'
  : isPlacePage ? '<link rel="stylesheet" href="/assets/field-note.css">' : '<link rel="stylesheet" href="/assets/site.css">';
const faqs = toolPage === 'checker' ? checker.faqs : legacy?.faqs;
---

<BaseLayout page={page} retainedHead={(legacy?.retainedHead || structuredHead) + '<link rel="stylesheet" href="/assets/mobile/mobile.css">'} theme={legacy?.theme || 'light'} faqs={faqs}>
  {isHome ? <>
    <div class="desktop-home">
      {legacy ? <Fragment set:html={legacy.body} /> : <StructuredPage page={page} />}
    </div>
    <MobileShell home><MobileHome /></MobileShell>
  </> : <>
    <div id="mw-page-content" tabindex="-1">
      {isPlanningHub ? <PlanningHub /> : isSearch ? <SearchPage /> : toolPage === 'checker' ? <LayoverChecker updatedAt={page.updatedAt} /> : toolPage === 'login' || toolPage === 'account' ? <AccountPage view={toolPage} /> : isPlacePage ? <PlaceGuide slug={page.route.slice('/guides/'.length)} updatedAt={page.updatedAt} /> : legacy ? <Fragment set:html={legacy.body} /> : <StructuredPage page={page} />}
    </div>
    <MobileShell contentTarget="#mw-page-content" />
  </>}
</BaseLayout>
