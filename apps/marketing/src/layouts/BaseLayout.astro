---
import ConsentBanner from '../components/ConsentBanner.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageBreadcrumbs from '../components/PageBreadcrumbs.astro';
import PageContinuity from '../components/PageContinuity.astro';
import { assetUrl, versionAssetUrls } from '../lib/asset-url.mjs';
import { serializeJsonLd } from '../lib/json-ld.mjs';
import type { SitePage } from '../lib/site-pages';
import { buildStructuredData } from '../lib/structured-data';

interface Props {
  page: SitePage;
  retainedHead?: string;
  theme?: string;
  faqs?: Array<{ question: string; answer: string }>;
}

const { page, retainedHead = '', theme, faqs = [] } = Astro.props;
const site = (Astro.site || new URL('https://detourtrips.com')).toString();
const canonical = new URL(page.route, site).toString();
const socialImage = new URL(page.image, site).toString();
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || 'G-54QYM83DKF';
const leadEndpoint = import.meta.env.PUBLIC_MARKETING_LEAD_ENDPOINT || '';
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || '';
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION || '';
// Website accounts switch on only when both public Supabase values are set at build time.
const supabaseUrl = (import.meta.env.PUBLIC_SUPABASE_URL || '').replace(/\/$/, '');
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
const accountsEnabled = Boolean(supabaseUrl && supabaseAnonKey);
// ADR-003: only the anon/publishable key may reach the browser. Fail the build on a secret key.
const keyRole = (() => { try { return JSON.parse(Buffer.from(supabaseAnonKey.split('.')[1] || '', 'base64url').toString()).role; } catch { return undefined; } })();
if (supabaseAnonKey.startsWith('sb_secret_') || keyRole === 'service_role') {
  throw new Error('PUBLIC_SUPABASE_ANON_KEY must be the anon (publishable) key, never a secret or service-role key.');
}
const structuredData = buildStructuredData(page, page.faqs || faqs);
const serializedStructuredData = serializeJsonLd(structuredData);
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{page.title}</title>
    <meta name="description" content={page.description}>
    <link rel="canonical" href={canonical}>
    {!page.index && <meta name="robots" content="noindex,nofollow">}
    <meta property="og:type" content={page.pageType === 'article' ? 'article' : 'website'}>
    <meta property="og:site_name" content="Detour">
    <meta property="og:locale" content="en_US">
    <meta property="og:title" content={page.socialTitle || page.title}>
    <meta property="og:description" content={page.socialDescription || page.description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={socialImage}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={page.socialTitle || page.title}>
    <meta name="twitter:description" content={page.socialDescription || page.description}>
    <meta name="twitter:image" content={socialImage}>
    {page.pageType === 'article' && <meta property="article:modified_time" content={page.updatedAt}>}
    {page.publishedAt && <meta property="article:published_time" content={page.publishedAt}>}
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
    <link rel="icon" type="image/svg+xml" href="/brand/detour-mark.svg">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="stylesheet" href={assetUrl('/assets/brand.css')}>
    <meta name="detour-ga-id" content={measurementId}>
    <meta name="detour-lead-endpoint" content={leadEndpoint}>
    {accountsEnabled && <meta name="detour-supabase-url" content={supabaseUrl}>}
    {accountsEnabled && <meta name="detour-supabase-key" content={supabaseAnonKey}>}
    {googleVerification && <meta name="google-site-verification" content={googleVerification}>}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification}>}
    <script type="application/ld+json" set:html={serializedStructuredData}></script>
    <style is:inline>
      @font-face{font-family:'Bricolage Grotesque';font-style:normal;font-weight:400 800;font-display:optional;src:url('/fonts/bricolage-grotesque-latin.woff2') format('woff2')}
      @font-face{font-family:'Plus Jakarta Sans';font-style:normal;font-weight:400 700;font-display:optional;src:url('/fonts/plus-jakarta-sans-latin.woff2') format('woff2')}
      @font-face{font-family:'DM Mono';font-style:normal;font-weight:400;font-display:optional;src:url('/fonts/dm-mono-latin.woff2') format('woff2')}
      @font-face{font-family:'Instrument Serif';font-style:italic;font-weight:400;font-display:optional;src:url('/fonts/instrument-serif-italic-latin.woff2') format('woff2')}
    </style>
    <Fragment set:html={versionAssetUrls(retainedHead)} />
    <link rel="stylesheet" href={assetUrl('/assets/site-navigation.css')}>
    <link rel="stylesheet" href={assetUrl('/assets/content-discovery.css')}>
    <link rel="stylesheet" href={assetUrl('/assets/page-context.css')}>
    <script is:inline>
      try { const saved = localStorage.getItem('detour-theme'); if (saved) document.documentElement.setAttribute('data-theme', saved); } catch {}
    </script>
  </head>
  <body>
    <SiteHeader route={page.route} accountsEnabled={accountsEnabled} />
    <div id="site-content" tabindex="-1">
      <PageBreadcrumbs route={page.route} />
      <slot />
      <PageContinuity route={page.route} />
    </div>
    <SiteFooter route={page.route} accountsEnabled={accountsEnabled} />
    <ConsentBanner />
    <script is:inline src={assetUrl('/assets/analytics.js')} defer></script>
    <script is:inline src={assetUrl('/assets/utm.js')} defer></script>
    {accountsEnabled && <script is:inline src={assetUrl('/assets/account-lite.js')} defer></script>}
    <script is:inline src={assetUrl('/assets/booking.js')} defer></script>
    <script is:inline src={assetUrl('/assets/site-navigation.js')} defer></script>
    <script is:inline>
      (() => {
        let applied = false;
        const applyBrandFonts = () => {
          if (applied) return;
          applied = true;
          document.documentElement.dataset.fonts = 'brand';
        };
        for (const event of ['pointerdown', 'touchstart', 'keydown', 'scroll']) {
          addEventListener(event, applyBrandFonts, { once: true, passive: true });
        }
        setTimeout(applyBrandFonts, 8000);
      })();
    </script>
  </body>
</html>
