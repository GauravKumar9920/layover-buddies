---
import places from '../data/place-guides.json';
import cityPhotos from '../data/city-photos.json';
import ExploreDiscovery from './ExploreDiscovery.astro';
import { OUTSIDE_OPTIONS } from '../lib/layover.mjs';
interface Props { slug?: string; updatedAt?: string }
const { slug, updatedAt } = Astro.props;
const place = places.find(p => p.slug === slug);
const updatedLabel = updatedAt ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${updatedAt}T00:00:00Z`)) : undefined;
const heading = (key: 'why' | 'context' | 'practical' | 'route', fallback: [string, string]) => place?.headings?.[key] ?? fallback;
const maps = (query: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
const directions = (query: string) => `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(query)}`;
// Nearest first, by straight-line distance, never suggesting a long-layover trip from a short-layover place.
const distance = (a: { lat: number; lng: number }, b: { lat: number; lng: number }) => Math.hypot(a.lat - b.lat, (a.lng - b.lng) * Math.cos((a.lat * Math.PI) / 180));
const related = place ? places.filter(p => p.slug !== slug && (p.region !== 'further' || place.region === 'further')).sort((a, b) => distance(a.geo, place.geo) - distance(b.geo, place.geo)).slice(0, 3) : [];
const regions = [
  { key: 'near-airport', title: 'Close to the', em: 'airport.', text: 'The western suburbs are the shortest drive from BOM, so these suit shorter layovers.' },
  { key: 'central', title: 'In the middle of', em: 'the city.', text: 'Worli, Mahalaxmi, Dadar and Byculla sit between the airport and South Mumbai.' },
  { key: 'south', title: 'South', em: 'Mumbai.', text: 'The old city: heritage streets, the harbour and the sea. Allow for the longest drive, or take the Aqua Line.' },
  { key: 'further', title: 'For long', em: 'layovers.', text: 'A ferry or a forest trail away. Only with plenty of hours and a generous buffer.' },
].map(r => ({ ...r, places: places.filter(p => p.region === r.key) })).filter(r => r.places.length);
const themes = [
  { key: 'sea', label: 'By the sea' },
  { key: 'heritage', label: 'Heritage & architecture' },
  { key: 'museums', label: 'Museums' },
  { key: 'faith', label: 'Places of worship' },
  { key: 'markets', label: 'Markets & street life' },
  { key: 'green', label: 'Green & quiet' },
  { key: 'rain', label: 'Good in the rain' },
];
const mapPlaces = JSON.stringify(places.map(p => ({ slug: p.slug, name: p.name, area: p.area, time: p.time, region: p.region, themes: p.themes, lat: p.geo.lat, lng: p.geo.lng })));
---
<div class="field-note">
  <main id="main-content">
    {place ? <>
      <header class="opening"><div class="eyebrow">{place.area} · Mumbai field notes</div><h1>{place.name.split(' ').slice(0,-1).join(' ')} <em>{place.name.split(' ').at(-1)}.</em></h1><p class="lead">{place.lead}</p><small>By the Detour founders{updatedLabel && ` · Updated ${updatedLabel}`}</small></header>
      <section id="photos" class="photo-browser" aria-label={`${place.name} photographs`} aria-roledescription="carousel">
        <div class="slide-window"><div class="slide-track">{place.photos.map((photo,i) => <a class="photo-slide" href={photo.src} target="_blank" rel="noopener" aria-label={`Open photo ${i+1} at full size`} aria-hidden={i > 0 ? 'true' : undefined} tabindex={i > 0 ? -1 : 0}><img class="slide-backdrop" src={photo.thumb} alt="" aria-hidden="true" loading={i === 0 ? 'eager' : 'lazy'} /><img class="hero" src={photo.src} alt={photo.alt} width="1600" height="1067" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} /></a>)}</div></div>
        <div class="gallery-bar"><div class="slide-dots" aria-label="Choose a photograph">{place.photos.map((_,i) => <button type="button" data-slide={i} aria-label={`Show photo ${i+1}`} aria-current={i === 0 ? 'true' : undefined}></button>)}</div><span class="gallery-label">{place.photos.length} photographs</span></div>
        <div class="sr-only" data-announcement aria-live="polite"></div>
        <a class="view-all-photos" href={`/guides/${place.slug}/photos`}>View all {place.photos.length} photos <span aria-hidden="true">↗</span></a>
        <details class="photo-credits"><summary>Photo credits</summary><ol>{place.photos.map(photo => <li>{photo.credit}{photo.license && <> · {photo.licenseUrl ? <a href={photo.licenseUrl} target="_blank" rel="noopener license">{photo.license}</a> : photo.license}</>}{photo.sourceUrl && <> · <a href={photo.sourceUrl} target="_blank" rel="noopener">Source</a></>}</li>)}</ol></details>
      </section>
      <div class="facts"><div><small>Suggested time</small><strong>{place.time}</strong></div><div><small>Best time</small><strong>{place.bestTime}</strong></div><div><small>Pairs with</small><strong>{place.pair}</strong></div><div><small>Before you leave</small><strong>Check live traffic</strong></div></div>
      <div class="body"><article><small>01 / Why make the detour</small><h2>{heading('why', ['A place to', 'pause.'])[0]} <em>{heading('why', ['A place to', 'pause.'])[1]}</em></h2><p>{place.why}</p>
        <section class="place-context" aria-labelledby="context-heading"><small>A little context</small><h2 id="context-heading">{heading('context', ['Behind the', 'place.'])[0]} <em>{heading('context', ['Behind the', 'place.'])[1]}</em></h2><div class="context-cards">{place.notes.map(note => <div class="context-card"><h3>{note.title}</h3><p>{note.summary}</p><details><summary><span class="when-closed">Read more</span><span class="when-open">Read less</span></summary><div class="context-copy"><p>{note.text}</p><a href={note.url} target="_blank" rel="noopener">Continue reading at {note.sourceLabel} ↗</a></div></details></div>)}</div></section>
        <section class="local-notes"><small>02 / On the ground</small><h2>{heading('practical', ['The useful', 'details.'])[0]} <em>{heading('practical', ['The useful', 'details.'])[1]}</em></h2><p>{place.practical}</p>{place.nearby && <><h3>A pause nearby</h3><p>{place.nearby}</p></>}</section>
      </article><aside class="note"><small>Before you go</small><h3>Make room for the return.</h3><p>{place.layover}</p>{place.mapLabel && <p><strong>Directions: {place.mapLabel}</strong></p>}<a class="button" href={maps(place.map)} target="_blank" rel="noopener">Open in Google Maps ↗</a><button type="button" class="save-place" data-mw-place={place.slug} aria-pressed="false">Save this place</button><p><a href={directions(place.map)} target="_blank" rel="noopener">Directions from your location ↗</a></p><a href="/guides/complete-mumbai-layover-guide">Plan your airport buffer →</a></aside></div>
        <section class="compact-route" aria-labelledby="route-heading"><small>03 / A route at your pace</small><h2 id="route-heading">{heading('route', ['A little room to', 'wander.'])[0]} <em>{heading('route', ['A little room to', 'wander.'])[1]}</em></h2><p class="muted">Suggested time at each stop; travel to and from the area is additional.</p><div class="route-grid">{place.route.map(([time,title,text],i) => <div class="stop"><small>{String(i+1).padStart(2,'0')} · {time}</small><h3>{title}</h3><p>{text}</p></div>)}</div></section>

      <section class="related"><small>Keep exploring</small><h2>Another <em>detour.</em></h2><div class="place-cards">{related.map(p => <a class="place-card" href={`/guides/${p.slug}`}><img src={p.photos[0].thumb} style={`object-position: ${p.photos[0].focus || "50% 50%"}`} alt={p.photos[0].alt} loading="lazy" width="480" height="320" /><small>{p.area}</small><h3>{p.name}</h3><p>{p.time}</p><span>Read field note ↗</span></a>)}</div><p><a href="/guides/places">See all places →</a></p></section>
    </> : <>
      <header class="opening"><div class="eyebrow">Mumbai / The place library</div><h1>A little closer<br>to the <em>city.</em></h1><p class="lead">Harbour air, heritage streets, a pause by the sea. Choose a place to explore through photographs, local context and a practical route.</p><small>{places.length} field notes · By the Detour founders</small></header>
      <div class="directory-intro"><p><strong>Still planning your layover?</strong> <a href="/guides/can-i-leave-mumbai-airport">Check how much time you’ll have outside the airport</a>, then choose a place that fits. Visas, luggage and your airport buffer are covered in our <a href="/guides">layover guides</a>.</p></div>
      <ExploreDiscovery />
      <section class="place-finder" aria-labelledby="finder-heading" data-place-finder hidden>
        <h2 id="finder-heading" class="sr-only">Filter places</h2>
        <div class="finder-controls">
          <div class="theme-chips" role="group" aria-label="Show places by theme"><button type="button" data-theme="" aria-pressed="true">All places</button>{themes.map(t => <button type="button" data-theme={t.key} aria-pressed="false">{t.label}</button>)}</div>
          <label class="finder-time"><span>Time outside the airport</span><select data-outside>{OUTSIDE_OPTIONS.map(o => <option value={o.value}>{o.label}</option>)}</select></label>
        </div>
        <p class="finder-status" data-finder-status aria-live="polite"></p>
        <div class="finder-empty" data-finder-empty hidden><p><strong>Under 2½ hours outside the airport is very tight.</strong> Most travellers are better off staying airside, eating well and resting. <a href="/guides/can-i-leave-mumbai-airport">Check your exact layover →</a></p></div>
        <div class="place-map-wrap"><div class="place-map" data-place-map data-places={mapPlaces} role="region" aria-label="Map of the places in this library. Each dot links to its field note."></div><ul class="map-legend" aria-hidden="true"><li><i class="dot near-airport"></i>Close to the airport</li><li><i class="dot central"></i>Central Mumbai</li><li><i class="dot south"></i>South Mumbai</li><li><i class="dot further"></i>Long layovers</li><li><i class="dot airport"></i>BOM airport</li></ul></div>
      </section>
      {regions.map(r => <section class="place-region" data-region={r.key} aria-labelledby={`region-${r.key}`}><h2 id={`region-${r.key}`}>{r.title} <em>{r.em}</em></h2><p class="muted">{r.text}</p><div class="place-cards">{r.places.map(p => <a class="place-card" href={`/guides/${p.slug}`} data-themes={p.themes.join(' ')} data-region={p.region}><img src={p.photos[0].thumb} style={`object-position: ${p.photos[0].focus || "50% 50%"}`} alt={p.photos[0].alt} loading="lazy" width="480" height="320" /><small>{p.area}</small><h3>{p.name}</h3><p>{p.lead}</p><div class="card-meta">{p.time} · {p.photos.length} photos</div><span>Read field note ↗</span></a>)}</div></section>)}
      <section class="city-context"><small>The wider view</small><h2>Between the <em>landmarks.</em></h2><p>Mumbai is more than its famous stops. A few views of the city around them.</p><div class="city-photos">{cityPhotos.map(photo => <figure><a href={photo.src} target="_blank" rel="noopener" aria-label={`Open full-size photograph: ${photo.alt}`}><img src={photo.thumb} alt={photo.alt} loading="lazy" width="480" height="320" /></a></figure>)}</div></section>
    </>}
    <section class="end"><small>Take a detour</small><h2>Your layover. A local’s <em>Mumbai.</em></h2><p>Explore with Gaurav and his co-founder. Share your flight timings so we can help shape a realistic route.</p><a class="button" href={place ? `/?place=${place.slug}#board` : '/#board'}>{place ? `Plan a detour to ${place.name} ↗` : 'Plan with the founders ↗'}</a></section>
  </main>
</div>
<script src="../scripts/field-note.js"></script>
<script src="../scripts/place-finder.js"></script>
