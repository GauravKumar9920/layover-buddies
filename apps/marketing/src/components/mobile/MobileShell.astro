---
import places from '../../data/place-guides.json';
interface Props { home?: boolean; contentTarget?: string }
const { home=false, contentTarget='#main-content' } = Astro.props;
const currentPlace = places.find(p=>Astro.url.pathname.replace(/\/$/,'') === `/guides/${p.slug}`);
---
<div class="mw-shell" data-mw-home={home ? 'true':'false'} data-mw-places={JSON.stringify(places.map(p=>({slug:p.slug,name:p.name})))}>
  <a class="mw-skip" href={home?'#mw-main':contentTarget}>Skip to content</a>
  <header class="mw-nav mw-glass"><a href="/" class="mw-brand" aria-label="Detour home"><img src="/brand/detour-logo.svg" width="148" height="40" alt="Detour" /></a><span class="mw-nav-location">MUMBAI / BOM</span><button data-mw-menu-open aria-label="Open navigation" aria-haspopup="dialog"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button></header>
  <dialog id="mw-menu" class="mw-dialog mw-menu" aria-labelledby="mw-menu-title"><button class="mw-close" data-mw-close aria-label="Close navigation">×</button><span class="mw-eyebrow">A LITTLE ROOM TO WANDER</span><h2 id="mw-menu-title">Where <em>next?</em></h2><a href="/">Home ↗</a><a href="/guides/places">Explore Mumbai ↗</a><a href="/guides">Plan your layover ↗</a><button class="mw-menu-saved" data-mw-saved-open>My saved places <span data-mw-saved-badge>0</span></button><a href="mailto:admin@detourtrips.com">Email the founders ↗</a><button class="mw-primary" data-mw-open>Plan my detour ↗</button></dialog>
  <slot />
  <footer class="mw-footer">{currentPlace && <div class="mw-save-current"><button data-mw-place={currentPlace.slug} aria-pressed="false" aria-label={`Save ${currentPlace.name}`}>Save this place</button><span>Add {currentPlace.name} to your plan</span></div>}<a class="mw-brand" href="/" aria-label="Detour home"><img src="/brand/detour-logo.svg" width="148" height="40" alt="Detour" /></a><p>A few hours. A whole other story.</p><a class="mw-contact" href="mailto:admin@detourtrips.com">Ask the founders ↗</a><div><a href="/privacy">Privacy</a><a href="/terms">Terms</a><button data-mw-glass aria-pressed="false">Reduce glass</button><button data-mw-clear>Clear saved plan</button></div><details><summary>Photo credits</summary><p>Hero: Vikram SN. Place photographs: Avijeet Si, Nishith Parikh, Manthan Sheth and the photographers credited in each place guide. From the supplied Detour photo collection.</p></details><small data-mw-storage-note>Your plan stays in this tab while you browse.</small></footer>
  <div class="mw-dock mw-glass"><button class="mw-dock-saved" data-mw-saved-open>My places <span data-mw-saved-badge>0</span><small>Your Mumbai shortlist</small></button><button class="mw-primary" data-mw-open>Plan my detour ↗</button></div>
  <dialog id="mw-saved" class="mw-dialog" aria-labelledby="mw-saved-title"><button class="mw-close" data-mw-close aria-label="Close saved places">×</button><span class="mw-eyebrow">A LITTLE COLLECTION OF POSSIBILITIES</span><h2 id="mw-saved-title">Your kind<br>of <em>Mumbai.</em></h2><p id="mw-saved-empty">Nothing saved yet. Explore the city and save the places you’d like to see.</p><div id="mw-saved-list"></div><a class="mw-text-link" href="/guides/places">Discover more places ↗</a><button class="mw-primary" data-mw-open>Plan around my shortlist ↗</button><p class="mw-fine">A wishlist, not a fixed route. Your hosts will help choose what fits.</p></dialog>
  <div class="mw-toast" id="mw-toast" role="status" hidden></div>
  <dialog id="mw-inquiry" class="mw-dialog" aria-labelledby="mw-inquiry-title">
    <button class="mw-close" data-mw-close aria-label="Close trip planner">×</button><span class="mw-eyebrow" id="mw-progress">YOUR DETOUR / STEP 1 OF 2</span><h2 id="mw-inquiry-title" tabindex="-1">A few details.<br>A better <em>detour.</em></h2><p class="mw-summary" id="mw-selection"></p><p class="mw-fine">No account. No payment at this step.</p>
    <form id="mw-form" novalidate>
      <div id="mw-details"><p class="mw-fine">All flight dates and times are local to Mumbai (IST, UTC+5:30). Your draft is saved in this tab for up to 12 hours. Use “Clear saved plan” in the footer to remove it.</p><label for="mw-name">Your name</label><input id="mw-name" name="name" autocomplete="name" required maxlength="120"/><label for="mw-email">Email</label><input id="mw-email" name="email" type="email" autocomplete="email" required maxlength="254"/><label for="mw-arrival">Arriving at BOM · Mumbai time</label><input id="mw-arrival" type="datetime-local" required/><label for="mw-departure">Departing from BOM · Mumbai time</label><input id="mw-departure" type="datetime-local" required/><label for="mw-flights">Flight numbers <span>(optional)</span></label><input id="mw-flights" name="flights" placeholder="e.g. AI 102 → BA 138" maxlength="160" autocapitalize="characters"/><label for="mw-notes">Anything that would make this easier? <span>(optional)</span></label><textarea id="mw-notes" rows="3" maxlength="1200" placeholder="Food preferences, walking pace, accessibility needs…"></textarea></div>
      <div id="mw-review" hidden><h3>Check your details</h3><dl id="mw-review-list"></dl><p class="mw-fine">We’ll check feasibility, availability and costs with you. This request does not confirm a booking.</p></div>
      <input type="hidden" name="arrival"/><input type="hidden" name="departure"/><input type="hidden" name="interests"/><input class="mw-honey" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true"/>
      <p id="mw-form-error" role="alert" hidden></p><div class="mw-form-actions"><button type="button" id="mw-edit" hidden>Edit details</button><button class="mw-primary" type="submit" id="mw-submit">Review my request ↗</button></div><p class="mw-fine">By sending, you share these details with Detour to plan your experience. <a href="/privacy">Privacy details</a></p>
    </form>
    <div id="mw-success" hidden tabindex="-1"><h3>Request received.</h3><p>Your hosts will review your details and reply by email. Your trip is not confirmed yet.</p><button class="mw-primary" data-mw-close>Keep exploring ↗</button><button class="mw-text-link" id="mw-new-request">Start another request</button></div>
  </dialog>
  <noscript><p class="mw-noscript">To request a detour without JavaScript, email <a href="mailto:admin@detourtrips.com">admin@detourtrips.com</a> with your flight times.</p></noscript>
</div>
<script is:inline src="/assets/mobile/mobile.js" defer></script>
