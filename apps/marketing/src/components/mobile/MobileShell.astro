---
import places from '../../data/place-guides.json';
import { assetUrl } from '../../lib/asset-url.mjs';
interface Props { home?: boolean; contentTarget?: string }
const { home=false, contentTarget='#main-content' } = Astro.props;
const currentPlace = places.find(p=>Astro.url.pathname.replace(/\/$/,'') === `/guides/${p.slug}`);
---
<div class="mw-shell" data-mw-home={home ? 'true':'false'} data-mw-places={JSON.stringify(places.map(p=>({slug:p.slug,name:p.name})))}>
  <slot />
  <div class="mw-dock mw-glass"><button class="mw-dock-saved" data-mw-saved-open>My places <span data-mw-saved-badge>0</span><small>Your Mumbai shortlist</small></button><button class="mw-primary" data-mw-open>Plan my detour</button></div>
  <dialog id="mw-saved" class="mw-dialog" aria-labelledby="mw-saved-title"><button class="mw-close" data-mw-close aria-label="Close saved places">×</button><span class="mw-eyebrow">A LITTLE COLLECTION OF POSSIBILITIES</span><h2 id="mw-saved-title">Your kind<br>of <em>Mumbai.</em></h2><p id="mw-saved-empty">Nothing saved yet. Explore the city and save the places you’d like to see.</p><div id="mw-saved-list"></div><a class="mw-text-link" href="/guides/places">Discover more places</a><button class="mw-primary" data-mw-open>Plan around my shortlist</button><p class="mw-fine">A wishlist, not a fixed route. Your hosts will help choose what fits.</p><p class="mw-fine" data-mw-storage-note>Your plan is saved in this browser tab for up to 12 hours.</p><details class="mw-reset"><summary>Start over</summary><p>This removes your saved places, checklist and unfinished request from this tab.</p><button data-mw-clear>Clear my plan and draft</button></details></dialog>
  <div class="mw-toast" id="mw-toast" role="status" hidden></div>
  <dialog id="mw-inquiry" class="mw-dialog" aria-labelledby="mw-inquiry-title">
    <button class="mw-close" data-mw-close aria-label="Close trip planner">×</button><span class="mw-eyebrow" id="mw-progress">YOUR DETOUR / STEP 1 OF 2</span><h2 id="mw-inquiry-title" tabindex="-1">A few details.<br>A better <em>detour.</em></h2><p class="mw-summary" id="mw-selection"></p><p class="mw-fine">No account or payment needed to enquire.</p>
    <form id="mw-form" novalidate>
      <div id="mw-details"><p class="mw-fine">All flight dates and times are local to Mumbai (IST, UTC+5:30). Your draft is saved in this tab for up to 12 hours. To remove it, open My places, then Start over.</p><label for="mw-name">Your name</label><input id="mw-name" name="name" autocomplete="name" required maxlength="120"/><label for="mw-email">Email</label><input id="mw-email" name="email" type="email" autocomplete="email" required maxlength="254"/><label for="mw-arrival">Arriving at BOM · Mumbai time</label><input id="mw-arrival" type="datetime-local" required/><label for="mw-departure">Departing from BOM · Mumbai time</label><input id="mw-departure" type="datetime-local" required/><label for="mw-flights">Flight numbers <span>(optional)</span></label><input id="mw-flights" name="flights" placeholder="e.g. AI 102, BA 138" maxlength="160" autocapitalize="characters"/><label for="mw-notes">Anything that would make this easier? <span>(optional)</span></label><textarea id="mw-notes" rows="3" maxlength="1200" placeholder="Food preferences, walking pace, accessibility needs…"></textarea></div>
      <div id="mw-review" hidden><h3>Check your details</h3><dl id="mw-review-list"></dl><p class="mw-fine">We’ll check feasibility, availability and costs with you. This request does not confirm a booking.</p></div>
      <input type="hidden" name="arrival"/><input type="hidden" name="departure"/><input type="hidden" name="interests"/><input class="mw-honey" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true"/>
      <p id="mw-form-error" role="alert" hidden></p><div class="mw-form-actions"><button type="button" id="mw-edit" hidden>Edit details</button><button class="mw-primary" type="submit" id="mw-submit">Review my request</button></div><p class="mw-fine">By sending, you share these details with Detour to plan your experience. <a href="/privacy">Privacy details</a></p>
    </form>
    <div id="mw-success" hidden tabindex="-1"><h3>Request received.</h3><p>Your hosts will review your details and reply by email. Your trip is not confirmed yet.</p><button class="mw-primary" data-mw-close>Keep exploring</button><button class="mw-text-link" id="mw-new-request">Start another request</button></div>
  </dialog>
  <noscript><p class="mw-noscript">To request a detour without JavaScript, email <a href="mailto:admin@detourtrips.com">admin@detourtrips.com</a> with your flight times.</p></noscript>
</div>
<script is:inline src={assetUrl('/assets/mobile/mobile.js')} defer></script>
