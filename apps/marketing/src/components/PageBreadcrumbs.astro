---
import { getSiteContent } from '../lib/site-content';
interface Props { route: string }
const { route } = Astro.props;
const content = await getSiteContent();
const item = content.find(entry => entry.route === route);
const trail = [];
const visited = new Set([route]);
let parent = item?.parentRoute;
while (parent && parent !== '/' && !visited.has(parent)) {
  visited.add(parent);
  const entry = content.find(candidate => candidate.route === parent);
  if (!entry) break;
  trail.unshift(entry);
  parent = entry.parentRoute;
}
---
{route !== '/' && <nav class="site-breadcrumbs" aria-label="Breadcrumb" data-site-breadcrumbs>
  <ol><li><a href="/">Home</a></li>{trail.map(entry => <li><a href={entry.route}>{entry.navigationTitle || entry.title}</a></li>)}<li><span aria-current="page">{item?.navigationTitle || item?.title || 'Page not found'}</span></li></ol>
</nav>}
