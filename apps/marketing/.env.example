# Public browser configuration
PUBLIC_GA_MEASUREMENT_ID=G-54QYM83DKF
PUBLIC_MARKETING_LEAD_ENDPOINT=https://YOUR_PROJECT.supabase.co/functions/v1/submit-marketing-lead
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=

# Website accounts (/login, /account, saved places). Leave both blank to keep
# accounts switched off. Use the project URL and the anon / publishable key ONLY;
# the build fails if a service-role or secret key is supplied.
# Deploy migration 20260926100000_website_accounts.sql and the updated
# submit-marketing-lead function before setting these in production.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Build-time Sanity content source. Leave blank to build from the checked-in
# local content and legacy parity sources.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2026-08-01
SANITY_READ_TOKEN=
# Preview builds only: requires SANITY_READ_TOKEN and must be deployed behind
# Vercel Deployment Protection. Never enable on the production deployment.
SANITY_PREVIEW_DRAFTS=false

# Used for canonical URLs and sitemap entries.
SITE_URL=https://detourtrips.com
