# Public browser configuration. Copy to .env.local and fill in real values.
# These are the same public credentials used by the mobile app. Never put a
# privileged database or Google service-account credential in a VITE_* value.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional links. Missing values are shown as "not configured" in the UI.
VITE_SANITY_STUDIO_URL=
VITE_SUPPORT_EMAIL=
