    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.5.27",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^8.0.16"
  }
}
