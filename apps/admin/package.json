{
  "name": "@detour/admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Secure operations, growth, trust and finance console for Detour.",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc -b && vite build",
