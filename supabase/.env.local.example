# Server-only Edge Function configuration. Copy to supabase/.env.local for
# local `supabase functions serve --env-file supabase/.env.local`; configure
# hosted values with `supabase secrets set`. Never expose these as VITE_* or
# PUBLIC_* variables.

# Public lead persistence, notification and abuse controls
LEAD_HMAC_SECRET=replace-with-at-least-24-random-characters
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=admin@detourtrips.com
LEAD_NOTIFICATION_FROM=Detour Leads <leads@detourtrips.com>

# Fixed server-side GA4 Data API reports
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Scheduled Search Console synchronization
SEARCH_CONSOLE_SITE_URL=sc-domain:detourtrips.com
SEARCH_CONSOLE_SEARCH_TYPE=web
SEARCH_SYNC_SECRET=replace-with-at-least-24-random-characters

# Sanity publish relay, Vercel deploy tracking and signed status callbacks
SANITY_WEBHOOK_SECRET=replace-with-sanity-webhook-secret
CONTENT_STATUS_SECRET=replace-with-a-different-24-character-secret
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/replace-me

# Vercel project webhook that reports build completion back to
# `vercel-deployment-webhook`. Without it a publish stays `building` forever.
# The secret is the signing secret Vercel shows when the webhook is created.
VERCEL_WEBHOOK_SECRET=replace-with-the-vercel-webhook-signing-secret
# Optional. Scopes completion events to the marketing project so another
# Vercel project in the same account can never resolve a publish.
VERCEL_MARKETING_PROJECT_ID=
